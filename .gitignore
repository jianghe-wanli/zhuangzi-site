# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data processing artifacts（一次性导入产物，数据已入库；勿再提交）
_updates_*.json
_qiwu_data.json
updates_json/

# test / build tooling
/test-results
/playwright-report
.vitest

# wrangler
.wrangler/

# 懒加载数据（构建期由 scripts/gen-lazy-data.mjs 生成）
/public/data/
# OG 图（构建期由 scripts/gen-og-images.mjs 生成）
/public/og/
# 字体源（约 25MB；子集化产物 public/fonts/slices/*.woff2 提交）
/scripts/fonts/NotoSerifSC.ttf
/scripts/fonts/chars.txt

# local screenshots (acceptance evidence, not source)
screenshots/

# 构建缓存（OG 图输入指纹等）与 ESLint 缓存
/.cache/
.eslintcache
.lighthouseci/
