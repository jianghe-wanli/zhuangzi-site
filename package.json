{
  "name": "zhuangzi-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-data.mjs && node scripts/gen-og-images.mjs && node scripts/gen-lazy-data.mjs && next build && node scripts/clean-duplicate-payload.mjs && node scripts/inject-csp-meta.mjs && node scripts/bump-sw-version.mjs",
    "start": "wrangler pages dev out --port 8788",
    "lint": "eslint --cache --cache-location .cache/eslint/ --max-warnings 0 \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"functions/**/*.js\" \"public/sw.js\" \"*.{ts,mts,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && node scripts/validate-data.mjs && npm run test",
    "budget": "node scripts/check-budget.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:output": "node scripts/check-output.mjs",
    "deploy": "npm run build && node scripts/check-output.mjs && wrangler pages deploy out --project-name zhuangzi-site",
    "clean": "node -e \"for (const d of ['.next','out','.cache']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-drag": "^3.0.1",
    "d3-force": "^3.0.1",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "leaflet": "^1.9.4",
    "next": "^16.4.6",
    "pinyin-pro": "^3.28.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.42.0",
    "zod": "^4.4.3"
  }
}
